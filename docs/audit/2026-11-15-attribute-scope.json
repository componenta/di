  "review_groups": {
    "composition": {
      "review": "Read complete implementations and marker contracts; traced definition revisions, capability conflicts, stable topological order, availability rechecks, argument construction and custom-rule cache bypass. No new confirmed defect."
    },
    "object_attributes": {
      "review": "Read complete contracts; checked supported targets and property/callback lifecycle. Parameter and request semantics coordinated with parameters_audit. Lazy/Proxy promises conflict with the confirmed propertyless-native behavior."
    },
    "attribute_processor_handlers": {
      "review": "Read complete processor/handler implementations; checked inherited private members, readonly/promoted handling, static and virtual property rejection, staged writes, handler order, exceptions and Make+Proxy composition. Request handler delegated."
    },
    "object_pipeline": {
      "review": "Read complete metadata/strategy/pipeline; traced before/after phases, context ownership, native deferred retry, fresh attribute instances and sharing. Propertyless native allocation bypasses the entire deferred callback, now reproduced."
    },
    "attribute_sequence": {
      "review": "Read complete sequence/guard/invoker; checked dynamic availability during attribute construction/handlers, completed-phase rejection, per-phase instances, semantic callback argument and exceptions. No new confirmed defect."
    },
    "entry_lifecycle": {
      "review": "Read complete implementation; checked property claims/staging/flush, setup method visibility, parameter provenance, callback semantic argument and deferred reentry. Earlier low-level API policy questions remain with existing plans."
    },
    "setup_unwrappers": {
      "review": "Read complete unwrappers; checked matching, coercion and Config/Env/ContainerValue/EntryId boundaries. No new confirmed defect."
    },
    "native_lazy_adapter": {
      "review": "Read complete implementations/contracts; confirmed missing callbacks for no/static-only/virtual-only properties on PHP8.4 and8.5; proved naive eager proxy fallback causes an extra destructor. Public deferred contracts require D1 policy decision; no unsafe fix applied."
    },
    "factory_boundary_reference": {
      "review": "Read as cross-scope reference to distinguish opaque factory products from explicit Make+Proxy and factory calls to lazy APIs. Core agent owns these files."
    }
  },
