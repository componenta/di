    "source": "<?php\ndeclare(strict_types=1);\nrequire __DIR__ . '/repo/tests/bootstrap.php';\n$results = [];\nforeach ([100, 1000, 3000] as $count) {\n    foreach (['forward', 'reverse'] as $order) {\n        $aliases = [];\n        for ($i = 0; $i < $count; ++$i) {\n            $aliases['alias.' . $i] = $i === 0 ? 'target' : 'alias.' . ($i - 1);\n        }\n        if ($order === 'reverse') $aliases = array_reverse($aliases, true);\n        $measurements = [];\n        for ($round = 0; $round < 3; ++$round) {\n            $start = hrtime(true);\n            $resolver = new Componenta\\DI\\Internal\\AliasResolver($aliases);\n            if ($resolver->resolve('alias.' . ($count - 1)) !== 'target') throw new LogicException('Wrong target.');\n            $measurements[] = (hrtime(true) - $start) / 1e6;\n        }\n        $results[] = ['aliases' => $count, 'order' => $order, 'ms' => $measurements];\n    }\n}\necho json_encode(['php' => PHP_VERSION, 'scope' => 'Local worst-case alias-chain construction, not an application benchmark.', 'results' => $results], JSON_PRETTY_PRINT | JSON_THROW_ON_ERROR), \"\\n\";\n",
