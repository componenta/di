      "name": "deferred_callable_retirement",
      "classification": "Confirmed regression-test gap; original production already correct.",
      "source": {
        "path": "src/Internal/DelegatorRegistry.php",
        "baseline_sha256": "b80fcf9a2f0690b01dc70f485d75c14d1d58a1085238b30e67357c9017f5e800",
        "mutant_sha256": "a4f4693dd3ab647e3ef11aeb32a305d69be5d4fa2c1befca1b4f5c197eb300a2",
        "mutation": "Remove the retention of a prepared callable owner in DelegatorRegistry::invalidate(), allowing its destructor to run during invalidation before the mutation has fully committed.",
        "exact_diff": "--- a/src/Internal/DelegatorRegistry.php\n+++ b/src/Internal/DelegatorRegistry.php\n@@ -58,7 +58,7 @@\n     public function invalidate(string $id, MutationRetirement $retirement): void\n     {\n         if (isset($this->callables[$id])) {\n-            $retirement->retain($this->callables[$id]);\n+            // Mutation witness: discard retired callable ownership.\n         }\n         unset($this->callables[$id]);\n         $this->revisions[$id] = ($this->revisions[$id] ?? 0) + 1;\n"
      },
      "old_scope": {
        "kind": "full_suite",
        "paths": [
          "tests"
        ],
        "new_retirement_file_present": false,
        "description": "Complete pre-existing test suite at the recorded baseline; the new retirement contract file was absent for both OLD controls."
      },
      "new_scope": {
        "kind": "one_complete_contract_file",
        "paths": [
          "tests/Contract/DeferredCallableRetirementContractTest.php"
        ]
      },
      "tests": {
        "published_commit": "2c52c285b806dbccffc7f43fba197aeeb01e4f6a",
        "old_sha256": {
          "tests/Contract/DeferredCallableRetirementContractTest.php": null
        },
        "new_sha256": {
          "tests/Contract/DeferredCallableRetirementContractTest.php": "35551a3fe06167f584c4a22d757b28b20f30adc406d4fcc48444de99d51faa7b"
        },
        "scenario": "Two warmed services use separate fresh callable objects returned by an external PSR container. Replacing that callable service retires both objects; their destructors re-enter both services, optionally throwing the same original LogicException.",
        "required_outcomes": [
          "Both destructors observe one:new and two:new after the completed mutation; no stale warmed value is visible.",
          "The replacement callable is the published service and runs only twice for the two re-resolved services.",
          "With throwing destructors, MutationRetirementException reports service decorator, both original causes, and the original previous exception after publication."
        ]
      },
      "red_observation": {
        "nonthrowing_case": {
          "expected": [
            [
              "one:new",
              "two:new"
            ],
            [
              "one:new",
              "two:new"
            ]
          ],
          "actual": [
            [
              "one:old",
              "two:old"
            ],
            [
              "one:old",
              "two:old"
            ]
          ]
        },
        "throwing_case": "Raw LogicException(\"Retired external callable owner.\") escapes instead of the committed-mutation retirement exception.",
        "both_runtimes": "The new file yields two failures and three assertions, exit 2. Restoring only the source restores both cases to GREEN with fifteen assertions."
      },
