{
    "name": "componenta/di",
    "description": "PSR-11 dependency injection container for PHP 8.5.13+ with composable attribute semantics, autowiring and lazy objects",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "di",
        "dependency-injection",
        "container",
        "ioc",
        "psr-11",
        "autowiring",
        "lazy-objects",
        "php85",
        "attributes"
    ],
    "authors": [
        {
            "name": "Componenta"
        }
    ],
    "homepage": "https://github.com/Componenta/di",
    "support": {
        "issues": "https://github.com/Componenta/di/issues",
        "source": "https://github.com/Componenta/di"
    },
    "require": {
        "php": "^8.5.13",
        "componenta/caster": "^1.0",
        "componenta/config": "^4.0",
        "componenta/reflection": "^3.0.0",
        "componenta/validation": "^3.1",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "nyholm/psr7": "^1.8",
        "pestphp/pest": "^4.0",
        "phpbench/phpbench": "^1.7",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "conflict": {
        "componenta/clock": "<1.2.0",
        "symfony/polyfill-php83": "<1.30.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\DI\\": "src/"
        },
        "files": [
            "src/Internal/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\DI\\Tests\\Support\\": "tests/Support/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "policy": {
            "abandoned": {
                "ignore": {
                    "doctrine/annotations": {
                        "on-block": false,
                        "reason": "PHPBench 1.x development-only dependency; benchmark discovery uses PHP attributes, not Doctrine annotations. Remove when PHPBench drops the dependency."
                    }
                }
            }
        }
    },
    "scripts": {
        "test": "pest",
        "test-platform": "@php -n tests/php85-platform.php",
        "test-coverage": "@php -d memory_limit=4G vendor/bin/pest --coverage --min=80",
        "test-mutation": [
            "Composer\\Config::disableProcessTimeout",
            "@php -d memory_limit=4G -d opcache.enable_cli=0 tests/mutate.php --mutate --path=src --everything --min=85 --compact"
        ],
        "phpstan": "phpstan analyse src tests --level=max",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "bench": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/phpbench run --config=phpbench.json.dist --report=aggregate --report=env"
        ],
        "bench-smoke": [
            "Composer\\Config::disableProcessTimeout",
            "@php benchmarks/smoke.php"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "provide": {
        "psr/container-implementation": "2.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "6.0.x-dev",
            "dev-fix/callback-dependency-baseline-2026-11-26": "6.0.x-dev"
        }
    }
}
