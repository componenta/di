+<?php
+
+declare(strict_types=1);
+
+namespace Componenta\DI\Attribute\Handler\Builtin;
+
+use Closure;
+use Componenta\DI\Attribute\Handler\ValueProviderDecoratorHandlerInterface;
+use Componenta\DI\Attribute\VirtualProxy;
+use Componenta\DI\Exception\InvalidConfigurationException;
+use Componenta\DI\ProxyFactoryInterface;
+use Componenta\DI\Resolver\Target\ValueTargetInterface;
+use Componenta\DI\Value\ValueContext;
+use LogicException;
+
+final readonly class VirtualProxyValueDecorator implements ValueProviderDecoratorHandlerInterface
+{
+    public function __construct(private ProxyFactoryInterface $proxies) {}
+
+    public function decorate(
+        object $attribute,
+        Closure $next,
+        ValueTargetInterface $target,
+        ValueContext $context,
+    ): mixed {
+        if (!$attribute instanceof VirtualProxy) {
+            throw new LogicException('VirtualProxyValueDecorator received an unsupported attribute.');
+        }
+
+        $class = $attribute->class ?? $target->className;
+        if ($class === null || !class_exists($class)) {
+            throw new InvalidConfigurationException(sprintf(
+                '#[VirtualProxy] on %s requires an explicit concrete proxy class.',
+                $target->declaringContext,
+            ));
+        }
+
+        foreach ($target->typeNames as $type) {
+            if (is_a($class, $type, true)) {
+                return $this->proxy($class, $next, $target);
+            }
+        }
+
+        if ($target->typeNames === []) {
+            return $this->proxy($class, $next, $target);
+        }
+
+        throw new InvalidConfigurationException(sprintf(
+            'Virtual proxy class %s is incompatible with %s.',
+            $class,
+            $target->declaringContext,
+        ));
+    }
+
+    /**
+     * @param class-string $class
+     * @param Closure(): mixed $next
+     */
+    private function proxy(string $class, Closure $next, ValueTargetInterface $target): object
+    {
+        return $this->proxies->makeProxy(
+            $class,
+            static function (object $_proxy) use ($class, $next, $target): object {
+                $value = $next();
+                if (!$value instanceof $class) {
+                    throw new InvalidConfigurationException(sprintf(
+                        'Virtual proxy provider for %s resolved %s; expected %s.',
+                        $target->declaringContext,
+                        get_debug_type($value),
+                        $class,
+                    ));
+                }
+
+                return $value;
+            },
+        );
+    }
+}
